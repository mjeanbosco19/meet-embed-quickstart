# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Tenant API key from your ETITE Meet console (server-side only).
MEET_API_KEY=

# Platform API base URL (the default below is the public ETITE Meet API).
MEET_API_URL=https://api.meet.etite.tech/api/v1

# Port for the quickstart server.
PORT=8787
